# The font and preview images rarely change; preview image links carry ?v= when they do.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og.jpg
  Cache-Control: public, max-age=31536000, immutable

/*/og.jpg
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
